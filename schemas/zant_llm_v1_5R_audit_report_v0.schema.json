{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zant-LLM v1.5R audit report",
  "type": "object",
  "required": [
    "version",
    "release_health_score",
    "audit_pass_rate",
    "smoke_pass_rate",
    "hotfix_readiness_score",
    "regression_replay_pass_rate",
    "blocking_issues",
    "post_release_audit_accepted",
    "runtime_authority_granted",
    "provider_dispatch_enabled"
  ],
  "properties": {
    "version": {
      "const": "v1.5R"
    },
    "release_health_score": {
      "type": "number"
    },
    "audit_pass_rate": {
      "type": "number"
    },
    "smoke_pass_rate": {
      "type": "number"
    },
    "hotfix_readiness_score": {
      "type": "number"
    },
    "regression_replay_pass_rate": {
      "type": "number"
    },
    "blocking_issues": {
      "type": "integer"
    },
    "post_release_audit_accepted": {
      "type": "boolean"
    },
    "runtime_authority_granted": {
      "type": "boolean"
    },
    "provider_dispatch_enabled": {
      "type": "boolean"
    }
  }
}
