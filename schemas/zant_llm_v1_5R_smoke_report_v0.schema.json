{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zant-LLM v1.5R smoke report",
  "type": "object",
  "required": [
    "version",
    "total",
    "passed",
    "blocked_probes",
    "smoke_pass_rate"
  ],
  "properties": {
    "version": {
      "const": "v1.5R"
    },
    "total": {
      "type": "integer"
    },
    "passed": {
      "type": "integer"
    },
    "blocked_probes": {
      "type": "integer"
    },
    "smoke_pass_rate": {
      "type": "number"
    }
  }
}
